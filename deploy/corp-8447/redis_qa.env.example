# Redis QA — Azure Managed Redis + Microsoft Entra (sin secretos)
# Cargar en el proceso del servicio cognitivo QA (no basta un export en otra consola).
#
# Host: bsc-cognitive-redis-qa.eastus.redis.azure.net:10000
# Auth: Access Keys DESHABILITADAS → identidad administrada de la VM.

GENESIS_ENV=qa
GENESIS_SESSION_BACKEND=redis
GENESIS_REDIS_REQUIRED=1
GENESIS_REDIS_AUTH_MODE=entra_managed_identity

# Endpoint/DB sin password ni token en la URL
GENESIS_REDIS_URL=rediss://bsc-cognitive-redis-qa.eastus.redis.azure.net:10000/0
GENESIS_CONV_LOCK_REDIS_URL=rediss://bsc-cognitive-redis-qa.eastus.redis.azure.net:10000/0

# Identidad: system-assigned de la VM (por defecto). Para UAI descomentar:
# GENESIS_REDIS_MANAGED_IDENTITY_TYPE=user_assigned
# GENESIS_REDIS_MANAGED_IDENTITY_CLIENT_ID=<client-id-uai>

GENESIS_REDIS_ENTRA_RESOURCE=https://redis.azure.com/
GENESIS_SESSION_TTL_S=1800
GENESIS_CONV_LOCK_TTL_S=30
GENESIS_SNAPSHOT_TTL_S=session
