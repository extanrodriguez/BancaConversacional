# Genesis Cognitive Layer - Environment
# Copy to .env and fill values. NEVER commit .env to git.

# --- Service ---
GENESIS_ENV=dev
GENESIS_HOST=0.0.0.0
GENESIS_PORT=8445
GENESIS_SLOW_CALL_MS=3000

# --- Azure OpenAI (same resource for chat + embeddings) ---
AZURE_OPENAI_ENDPOINT=https://aoai-genesis-871a5b-7e0e0.openai.azure.com/
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# --- Azure AI Search (RAG index) ---
AZURE_SEARCH_ENDPOINT=https://genesis-search-lab.search.windows.net
AZURE_SEARCH_INDEX=genesis-kb
AZURE_SEARCH_API_KEY=

# --- Data ---
GENESIS_SQLITE_PATH=data/demo/modelo_bancario_genesis_v2.sqlite
GENESIS_KB_DIR=Knowledge_Base

# --- Auth: AzureCliCredential (default) ---
# Run 'az login' on the VM. No API key needed for OpenAI.
# For AI Search admin key, fill AZURE_SEARCH_API_KEY above.

# --- Latency telemetry ---
# Threshold (ms) above which a request is logged as SLOW_REQUEST (WARNING).
GENESIS_SLOW_REQUEST_MS=10000
