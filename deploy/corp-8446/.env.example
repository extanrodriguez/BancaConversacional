# Genesis Cognitive 8446 — Environment Variables
# Copy to .env, fill secrets, chmod 600, chown genesis:genesis
# NEVER commit .env to git or include in ZIP

# --- Service ---
GENESIS_ENV=dev
GENESIS_HOST=0.0.0.0
GENESIS_PORT=8446
GENESIS_SERVE_UI=false
GENESIS_SLOW_CALL_MS=3000
GENESIS_SLOW_REQUEST_MS=10000

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://testbsc0001.openai.azure.com/
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_API_KEY=

# --- Azure AI Search ---
AZURE_SEARCH_ENDPOINT=https://ai-search-genesis.search.windows.net
AZURE_SEARCH_INDEX=genesis-rag-index
AZURE_SEARCH_API_KEY=

# --- Data ---
GENESIS_SQLITE_PATH=data/demo/modelo_bancario_genesis_v2.sqlite
GENESIS_KB_DIR=Knowledge_Base
