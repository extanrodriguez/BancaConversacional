# Genesis API — Fase 1 Docker Compose
# Copiar a .env en la raíz del repo (NO commitear)

# --- Servidor ---
GENESIS_HOST=0.0.0.0
GENESIS_PORT=8445
GENESIS_ENV=dev
GENESIS_SERVE_UI=true
GENESIS_UVICORN_WORKERS=1

# --- Redis (obligatorio en compose) ---
GENESIS_REDIS_URL=redis://redis:6379/0
GENESIS_SESSION_TTL_S=1800
GENESIS_SNAPSHOT_TTL_S=600

# --- SQLite demo (opcional) ---
GENESIS_SQLITE_PATH=/app/data/demo/modelo_bancario_genesis_v2.sqlite

# --- Azure OpenAI (obligatorio) ---
AZURE_OPENAI_ENDPOINT=https://aoai-genesis-871a5b-7e0e0.openai.azure.com/
AZURE_OPENAI_API_KEY=REEMPLAZAR
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# --- Azure AI Search (RAG local / legacy) ---
AZURE_SEARCH_ENDPOINT=https://genesis-search-lab.search.windows.net
AZURE_SEARCH_API_KEY=REEMPLAZAR
AZURE_SEARCH_INDEX=genesis-kb

# --- Foundry KB Agent (opcional; mejora knowledge sin tocar path personal) ---
# Proyecto: https://ai.azure.com/.../genesis-rag-poc/build/agents/genesis-kb-agent-poc
# Auth: DefaultAzureCredential (az login en lab; Managed Identity en VM)
GENESIS_FOUNDRY_KB_AGENT=0
GENESIS_FOUNDRY_PROJECT_ENDPOINT=https://foundry-bsc-genesis-dev.services.ai.azure.com/api/projects/genesis-rag-poc
GENESIS_FOUNDRY_KB_AGENT_NAME=genesis-kb-agent-poc
GENESIS_FOUNDRY_KB_AGENT_VERSION=5
