# Deploy 8447 — instancia de evolución QA (paralela a 8446)
GENESIS_ENV=dev
GENESIS_HOST=0.0.0.0
GENESIS_PORT=8447
GENESIS_SERVE_UI=false
GENESIS_FAQ_PATH=/opt/genesis-cognitive-8447/Genesis_v2/data/kb_faq_vf01.json
GENESIS_FAQ_OVERLAY_PATH=/opt/genesis-cognitive-8447/Genesis_v2/data/kb_faq_overlay_fase1.json
GENESIS_RAG_NO_HUMAN_ESCALATION_INSTITUTIONAL=1
GENESIS_FAQ_INSTITUTIONAL_MIN_SCORE=0.65
GENESIS_DISABLE_OPTIONS=0
# Contexto de cliente atado a la sesión (no TTL corto independiente)
GENESIS_SNAPSHOT_TTL_S=session
GENESIS_SESSION_TTL_S=1800

# Azure AI Search — mismo índice que el agente Foundry
AZURE_SEARCH_ENDPOINT=https://ai-search-genesis.search.windows.net
AZURE_SEARCH_INDEX=bsc-kb-conocimiento
# AZURE_SEARCH_API_KEY=... (en el host)

# Foundry KB Agent (conocimiento; no path personal)
GENESIS_FOUNDRY_KB_AGENT=1
GENESIS_FOUNDRY_PROJECT_ENDPOINT=https://foundry-bsc-genesis-dev.services.ai.azure.com/api/projects/genesis-rag-poc
GENESIS_FOUNDRY_KB_AGENT_NAME=genesis-kb-agent-poc
GENESIS_FOUNDRY_KB_AGENT_VERSION=5

# P0 — Puerta de confianza FAQ → Foundry (OFF por defecto en local; ON en deploy 8447)
GENESIS_KB_CONFIDENCE_GATE=1
GENESIS_FAQ_HIGH_SCORE=0.90
GENESIS_FAQ_GRAY_MIN=0.55
GENESIS_FAQ_GRAY_MAX=0.85

# P1 — Cache Foundry topic|intent
GENESIS_FOUNDRY_CACHE=1
GENESIS_FOUNDRY_CACHE_TTL_S=86400
GENESIS_FOUNDRY_CACHE_DIR=/opt/genesis-cognitive-8447/Genesis_v2/data/cache/foundry_kb

# Foundry tools personales (get_customer_products) — OFF hasta validación regresión
GENESIS_FOUNDRY_PRODUCT_TOOLS=0

# Azure como cerebro de intención (hechos solo snapshot/KB)
GENESIS_AZURE_BRAIN=1
# Fase 2: redacción natural Azure sobre hechos ya verificados (no inventa números)
GENESIS_AZURE_DRAFT=1

# Redis Azure Managed (QA) — TLS + Microsoft Entra (Access Keys deshabilitadas)
# Ver deploy/corp-8447/redis_qa.env.example y works/CONEXION_REDIS_QA_ENTRA.md
# GENESIS_REDIS_AUTH_MODE=entra_managed_identity
# GENESIS_SESSION_BACKEND=redis
# GENESIS_REDIS_REQUIRED=1
# GENESIS_REDIS_URL=rediss://bsc-cognitive-redis-qa.eastus.redis.azure.net:10000/0
# GENESIS_CONV_LOCK_REDIS_URL=rediss://bsc-cognitive-redis-qa.eastus.redis.azure.net:10000/0

# Bootstrap contexto /pruebas (mismo template que orch .NET Presentation Product)
GENESIS_PRESENTATION_PRODUCT_URL_TEMPLATE=https://apigateway-gen.qa.bsc.com.do/api/presentation/product/{customerId}
GENESIS_PRESENTATION_ALLOW_INSECURE_TLS=1
GENESIS_PRESENTATION_TIMEOUT_S=25

